import geopandas as gpd
import matplotlib.pyplot as plt
import matplotlib.colors as mcolors
import pandas as pd

# 1. District GeoJSON file load pannanum
# Tamil Nadu districts GeoJSON path inga tharavum
geojson_path = "tamil_nadu_districts.geojson"
gdf = gpd.read_file(geojson_path)

# 2. Manual Data Entry (District Name matrum Rainfall in mm)
# Intha dictionary-la unga manual data-vai update pannikkalaam
manual_data = {
    'district': [
        'Chennai', 'Tiruvallur', 'Kancheepuram', 'Chengalpattu', 
        'Vellore', 'Ranipet', 'Tirupathur', 'Viluppuram',
        'Salem', 'Dharmapuri', 'Krishnagiri', 'Madurai', 
        'Sivaganga', 'Ramanathapuram', 'Virudhunagar', 'Coimbatore'
    ],
    'rainfall': [
        45.0, 35.0, 40.0, 30.0, 
        20.0, 18.0, 12.0, 25.0, 
        8.0, 5.0, 3.0, 15.0, 
        10.0, 4.0, 2.0, 1.5
    ]
}

df_rain = pd.DataFrame(manual_data)

# 3. GeoJSON kooda manual data merge panrom
# Note: GeoJSON-la irukkira district column name 'district_name' illai 'district'-nu match pannanum
merged = gdf.merge(df_rain, left_on='district_name', right_on='district', how='left')
merged['rainfall'] = merged['rainfall'].fillna(0) # Data illatha idathuku 0

# 4. Color Scale & Levels (Image-la irukka pola custom levels)
bounds = [0.1, 1.0, 5.0, 15.0, 30.0, 50.0, 80.0, 150.0, 300.0]
colors = [
    '#e0f3f8', '#abd9e9', '#74add1', '#4575b4', 
    '#78c679', '#31a354', '#ffffbf', '#fee08b', '#d73027'
]
cmap = mcolors.ListedColormap(colors)
norm = mcolors.BoundaryNorm(bounds, cmap.N, extend='both')

# 5. Plotting
fig, ax = plt.subplots(1, 1, figsize=(10, 12))

# Map plot
merged.plot(
    column='rainfall',
    cmap=cmap,
    norm=norm,
    linewidth=0.8,
    ax=ax,
    edgecolor='black',
    legend=True,
    legend_kwds={'label': "Rainfall Intensity (mm)", 'orientation': "vertical", 'shrink': 0.7}
)

# Title & Headings
plt.title("Rainfall Forecast / Actual Observation\nValid Till: 24 Hours", fontsize=14, weight='bold', pad=15)
ax.set_axis_off()

# Save image
plt.savefig("tamilnadu_rainfall_map.png", dpi=300, bbox_inches='tight')
print("Map successfully created: tamilnadu_rainfall_map.png")
